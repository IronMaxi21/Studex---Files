# Copy to .env — the npm scripts load it automatically.
# Defaults here are for local development.

NODE_ENV=development
PORT=8080
HOST=127.0.0.1

# REQUIRED in production; the server refuses to boot without it.
# Generate one with:  openssl rand -hex 32
# Left blank in development, where an ephemeral secret is generated per restart
# (which signs everyone out on reboot — the safe direction to fail).
SESSION_SECRET=

DATABASE_PATH=./data/studex.sqlite
STORAGE_DIR=./data/blobs

# Serve the desktop UI from this process as well as the API. Unset, the server
# is a pure JSON API. The Mac app sets it to the web folder inside its bundle.
# WEB_DIR=../studex-mac/web

# Whether the session cookie is marked Secure. Follows NODE_ENV by default, and
# may only be turned off in production when HOST is loopback — which is the
# desktop app, serving itself over http on a port that never leaves the machine.
# COOKIE_SECURE=

# Exact origins allowed to call the API with credentials, comma separated.
# Also the allowlist used for Origin checks on state-changing requests.
CORS_ORIGINS=http://localhost:5173

# Per-user storage quota (20 GB, matching the Library screen)
STORAGE_QUOTA_BYTES=21474836480
MAX_UPLOAD_BYTES=104857600

# Credential-endpoint requests per IP per 5 minutes
AUTH_RATE_LIMIT_MAX=10

# Set true only behind a proxy you control (makes the app trust X-Forwarded-For)
TRUST_PROXY=false

# ── Identity provider ───────────────────────────────────────────────────
# Set both to have Supabase verify email and password; the server then issues
# its own session cookie on success, so everything downstream is unchanged.
# Leave both blank to keep the server's own argon2 credentials — which is the
# only mode that works with no network.
#
# URL must be the project origin with no path. The dashboard also shows a REST
# endpoint ending /rest/v1 — that is not this, and the server refuses it,
# because supabase-js appends its own paths.
#
# The anon key is publishable by design. It is only actually restrictive if
# row-level security is enabled on every table in the project.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Where the link in a confirmation email lands. It must also be on the
# project's Authentication › URL Configuration redirect allow-list, or Supabase
# silently substitutes the Site URL and the link goes nowhere useful.
#
# Left blank, this is the page Studex publishes for it, which says the address
# is confirmed and offers to open the app already installed on the device:
#   https://ironmaxi21.github.io/Studex-releases/confirmed/
SUPABASE_EMAIL_REDIRECT_URL=

# Only on the machine that cuts releases, and never in the app bundle.
#
# Publishing a version is one row in public.releases, and that table decides
# which code every install runs — so the anon key above may only read it. The
# service role key is what `npm run publish:release` writes with. Leave it
# blank everywhere else: a server that merely runs Studex has no business
# being able to update every other copy of it.
SUPABASE_SERVICE_ROLE_KEY=

# Sync when the project says a row moved, rather than only on the timer. On by
# default wherever a project is configured; the timer is unaffected either way,
# and an account that has switched automatic sync off is not watched at all.
#
# It needs section 3 of supabase/setup.sql to have been run — without the table
# in the publication the socket connects, hears nothing, and every sync still
# happens on schedule.
SYNC_REALTIME=true

# ── Payments ────────────────────────────────────────────────────────────
# All three are required together, or none of them. The server refuses to boot
# on a partial set: a secret key with no webhook secret builds a checkout that
# takes money and then has no way to hear that it was paid.
#
# Leave them blank and the app simply has no checkout — the Pro sheet says so
# rather than offering a button that cannot work. Entitlements can still be
# granted by hand, which is how the plan worked before this existed.
#
# The secret key is a real credential: it can move money. It belongs in the
# environment of the machine running the server and nowhere else — never in the
# app bundle, which is handed to the people buying.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Where the Stripe billing portal sends people when they are done. Defaults to
# the server's own return page.
# STRIPE_PORTAL_RETURN_URL=

# ── AI ──────────────────────────────────────────────────────────────────
# Unset, Studex has no AI features and the interface says so rather than
# offering buttons that cannot work. Set the key and it has all of them:
# specification import, cards, quizzes, explain-this-highlight, revision
# plans and duplicate-topic merging.
#
# The key stays on the server. The interface never holds it and never talks to
# the model directly — which is also the only reason the monthly allowance
# below can be enforced at all. On the desktop app the key is pasted into
# Settings → AI instead, and this variable, when set, wins over it.
#
# A Google AI Studio key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The Gemini model behind each role. Defaults shown.
# AI_MODEL_READER=gemini-flash-latest
# AI_MODEL_WRITER=gemini-flash-latest
# AI_MODEL_CHECKER=gemini-flash-lite-latest
# A proxy, if you run one. Must be https, or a loopback address.
# AI_BASE_URL=https://generativelanguage.googleapis.com

# Requests per account per calendar month, before the Pro multiplier. Every
# one of them spends money that whoever runs this install is paying.
AI_MONTHLY_REQUESTS=30
# Per-IP loop-stopper. The monthly cap above is the real limit.
AI_RATE_LIMIT_MAX=10
